# ========================================================
# ENVIRONMENT VARIABLES TEMPLATE FOR PRODUCTION (RAILWAY/RENDER)
# ========================================================

# Activate the production profile
SPRING_PROFILES_ACTIVE=prod

# Server Port (Auto-provided by Railway/Render, usually 8080 or random port)
PORT=8080

# Your Public Cloud URL (Used for generating payment links & webhooks)
APP_BASE_URL=https://your-bot-name.up.railway.app

# Supabase PostgreSQL Database Credentials
# (Found in Supabase: Project Settings -> Database -> Connection string -> JDBC)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.your_project_ref
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password

# Meta WhatsApp Cloud API Credentials
WHATSAPP_PHONE_NUMBER_ID=1341058652432056
WHATSAPP_ACCESS_TOKEN=your_permanent_or_system_meta_access_token
WHATSAPP_VERIFY_TOKEN=bakery_bot_secret_token

# Payment (UPI / PayZapp / Razorpay)
PAYMENT_UPI_VPA=your_upi_id@bank
PAYMENT_UPI_NAME=Sweet Delights Bakery
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
